generator client {
  provider = "prisma-client-js"
  output   = "../src/generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Metric {
  id        String   @id @default(uuid())
  name      String
  value     Float
  timestamp DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  timestamp DateTime @default(now())
}

model SystemPerformance {
  id           String   @id @default(uuid())
  metricName   String
  metricValue  Float
  timestamp    DateTime @default(now())
}
